            "post": {
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "games"
                ],
                "summary": "Make a move",
                "operationId": "makeMove",
                "parameters": [
                    {
                        "type": "string",
