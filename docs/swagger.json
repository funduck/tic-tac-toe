        "/api/users/refresh-token": {
            "post": {
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "users"
                ],
                "summary": "Refresh access token using refresh token",
                "operationId": "refresh-token",
                "parameters": [
                    {
                        "description": "User refresh token request",
                        "name": "request",
                        "in": "body",
                        "required": true,
